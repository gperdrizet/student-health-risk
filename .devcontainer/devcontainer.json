// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "Kaggle Student Health",
	// "image": "mcr.microsoft.com/devcontainers/python:3.12-trixie", # Base image with Python 3.12 and common data science libraries
	"image": "gperdrizet/kaggle-nvidia:6.0.1",
    "runArgs": [
		"--network=bridge",   // Explicitly use bridge network for internet access
		"--gpus",             // Enable the two Tesla P100 GPUs in the container
		"\"device=1,2\"",
		"--cpuset-cpus=4-23", // Limit container to CPU cores 8-23 to avoid thrashing the host 
		                      // system and to allow other processes to run on cores 0-3
		"--cpus=20",          // Limit container to 20 total CPU cores to avoid thrashing
		"--memory=200g",      // Limit container memory
		"--memory-swap=200g", // Limit total memory + swap to 200GB to avoid swapping
		"--shm-size=4g"       // Limit shared memory to 4GB
	],
	"remoteUser": "vscode",   // Use the 'vscode' user provided by the base image

	// Custom configuration options
	"customizations": {

	  // Configure VS Code settings and extensions
	  "vscode": {

		// Use 'settings' to set default VS Code values on container create
		"settings": {
			// Set the default Python interpreter
			"python.defaultInterpreterPath": "/usr/bin/python",

			// Exclude system Python 3.13 environment
			// Prevents confusion by hiding system Python versions we don't want to use
			"jupyter.kernels.excludePythonEnvironments": [],

			// Disable automatic port forwarding and restoration of forwarded ports
			// from prior sessions to give explicit control
			"remote.restoreForwardedPorts": false,
			"remote.autoForwardPorts": false
		},

		// Extensions for Python data science work
		"extensions": [
		  "-dbaeumer.vscode-eslint",                // Explicitly exclude ESLint (not needed for Python projects)
		  "ms-python.python",                       // Core Python language support, IntelliSense, debugging
		  "ms-toolsai.jupyter",                     // Jupyter notebook support for interactive data science
		  "streetsidesoftware.code-spell-checker"   // Spell checking for code and documentation
		]
	  }
	},

	// Create data and notebooks directories on first container creation
	// Updates pip and installs project Python dependencies
	"onCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",

	// Data files are fetched from an external server instead of being stored with Git LFS.
	"postCreateCommand": "",

	// Use 'postAttachCommand' to run commands each time a user connects to the container
	"postAttachCommand": ""
}